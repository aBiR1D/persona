# Persona Market — Environment Configuration
# Copy to .env and fill in your API keys.

# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# API Keys (at least one required for chat)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Database
DB_PATH=persona_market.db

# Platform economics
PLATFORM_COMMISSION=0.20
DEFAULT_PRICING=5.0

# API server
API_HOST=0.0.0.0
API_PORT=8000
